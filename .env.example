# PayPilot AI — Environment Configuration
# Copy this file to .env and configure your keys

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL) — Local or Cloud (Neon / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/paypilot_db?schema=public

# Authentication
JWT_SECRET=paypilot_super_secret_jwt_key_for_dev_change_in_prod_12345

# AI Provider Configuration (Google Gemini / OpenAI / Groq)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.5-flash

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
