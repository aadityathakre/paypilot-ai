# PayPilot AI — Environment Configuration Example
# Copy this file to .env and configure your local or production keys

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL) — Local or Cloud (Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/paypilot_db?sslmode=prefer"

# Authentication Dual Token Architecture
JWT_SECRET=demo_paypilot_jwt_master_secret_key_2026_secured_dev
JWT_ACCESS_SECRET=demo_paypilot_access_token_secret_key_2026_dev
JWT_REFRESH_SECRET=demo_paypilot_refresh_token_secret_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider Configuration (Google Gemini / OpenAI / Groq)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_demo_key_id
RAZORPAY_KEY_SECRET=demo_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=demo_razorpay_webhook_secret

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=demo_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_cloudinary_api_secret_key

# Nodemailer Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=demo.user@example.com
SMTP_PASS=demo_16_char_app_password
SMTP_FROM="PayPilot AI <demo.user@example.com>"
